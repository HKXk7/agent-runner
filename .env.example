# ===== Agent Runner 环境变量示例 =====
# 复制本文件为 .env（或直接 export）。所有变量均可选，
# 不配置即为「零 key mock 模式」：内置 Mock LLM + 本地 fixture。

# ---- LLM 接入（不填则用 MockProvider，零成本演示）----
# 任意 OpenAI 兼容端点（OpenAI / DeepSeek / 硅基流动 等 /v1/chat/completions）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- 调度 ----
# 单进程并发槽位（默认 1）
AGENT_RUNNER_CONCURRENCY=1
# 是否开启每日定时任务（0 关闭；默认开，07:30 抓校园通知）
AGENT_RUNNER_CRON=1
# 强制 mock 抓取（1 强制用 fixture，不访问真实网页）
AGENT_RUNNER_MOCK=0

# ---- HTTP ----
PORT=8787

# ---- 推送（不填则回退本地文件收件箱）----
# Server酱：https://sct.ftqq.com 注册拿 SendKey
SERVERCHAN_SENDKEY=
# PushPlus：https://www.pushplus.plus 注册拿 token
PUSHPLUS_TOKEN=
